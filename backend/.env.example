# ─── App ───────────────────────────────────────────
APP_NAME="JobHunt Backend"
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days for local use

# ─── Database ──────────────────────────────────────
# Local Postgres (default). Change to Supabase URL when deploying.
DATABASE_URL=postgresql://postgres:haru@localhost:5432/jobhunt

# ─── AI ────────────────────────────────────────────
# Switch provider: "claude" or "gemini"
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ─── Redis (for Celery background tasks) ───────────
REDIS_URL=redis://localhost:6379/0

# ─── File Storage ──────────────────────────────────
# local = store in /uploads folder. s3 = use AWS S3.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# S3 (only needed if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ─── Scraping ──────────────────────────────────────
# Optional: RapidAPI key for JSearch (LinkedIn/Indeed data without scraping)
JSEARCH_API_KEY=
RAPIDAPI_KEY=
